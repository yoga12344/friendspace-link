# ==============================================================================
# FRIENDSPACE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local for local development.
# NEVER commit real production credentials or .env files to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL pooled connection string from Neon dashboard with sslmode=require.
# Example: postgresql://neondb_owner:password@ep-name.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/friendspace?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Auth.js v5 / NextAuth)
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 32-byte secret using: openssl rand -base64 32
AUTH_SECRET="generate-a-secure-random-32-byte-secret"
NEXTAUTH_SECRET="generate-a-secure-random-32-byte-secret"

# Canonical public web application URL (without trailing slash)
# Production: https://friendspace.app or https://your-app.vercel.app
# Local Development: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. REAL-TIME SOCKET.IO SERVER (Standalone Persistent Node Process)
# ------------------------------------------------------------------------------
# Public URL accessible from client browsers to connect via WebSocket.
# Production: https://socket.friendspace.app or https://friendspace-socket.onrender.com
# Local Development: http://localhost:3001
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# Internal URL used by Next.js server-side API routes to dispatch /broadcast events.
# Production: private network address or https://friendspace-socket.onrender.com
# Local Development: http://127.0.0.1:3001
SOCKET_INTERNAL_URL="http://127.0.0.1:3001"

# Shared secret key between Next.js backend and Socket.IO server for /broadcast.
# MUST NOT be exposed to client-side code (do NOT prefix with NEXT_PUBLIC_).
SOCKET_BROADCAST_SECRET="generate-a-secure-internal-broadcast-secret"
INTERNAL_SECRET="generate-a-secure-internal-broadcast-secret"

# Port for the standalone Socket.IO server process.
# Cloud platforms (Render, Railway, Fly.io) automatically inject PORT.
PORT="3001"
SOCKET_PORT="3001"

# Allowed web origin for Socket.IO CORS in production.
# Production: https://your-app.vercel.app (or custom domain)
# Local Development: http://localhost:3000
SOCKET_ALLOWED_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'production' on Vercel and production Socket host.
NODE_ENV="development"
